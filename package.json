{
  "name": "talk-to-my-portfolio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:critical": "pnpm --filter @neryc/portfolio-mcp test -- --reporter=verbose -t '@critical'",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter web dev",
    "sync:platzi": "pnpm --filter sync-platzi sync"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.3.0",
    "@changesets/cli": "^2.27.0"
  }
}
