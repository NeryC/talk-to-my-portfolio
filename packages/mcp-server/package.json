{
  "name": "@neryc/portfolio-mcp",
  "version": "0.0.0",
  "description": "Talk to my portfolio: an MCP server exposing Nery Cano's CV, projects, and verifiable Platzi courses.",
  "license": "MIT",
  "author": "Nery Cano <hello@neryc.dev>",
  "homepage": "https://talk-to-my-portfolio.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeryC/talk-to-my-portfolio.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "bin": {
    "portfolio-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@neryc/portfolio-shared": "workspace:*",
    "resend": "^4.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
